# ==========================================
# IBNS Smart Ops - Environment Configuration
# ==========================================
# Duplicate this file to '.env' and provide strong, unique secrets:
# cp .env.example .env

# PostgreSQL Database Configuration
DB_USER=odoo
DB_PASSWORD=change_this_to_a_strong_database_password
DB_NAME=odoo

# Odoo Master Password (admin_passwd)
# Catatan: Odoo membaca master password langsung dari file 'config/odoo.conf'
# (parameter `admin_passwd`), bukan dari file .env ini. Default dev: admin_dev_password.

# SFA Headless REST API Integration Key (Optional system fallback key)
# Recommended: Generate per-user API keys via Odoo User Profile > Account Security > API Keys
SFA_API_SECRET_KEY=change_this_to_a_random_64_character_hex_token
