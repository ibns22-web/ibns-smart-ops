<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Module Security Category -->
        <record id="module_category_operations_tms" model="ir.module.category">
            <field name="name">TMS &amp; SFA Logistics</field>
            <field name="description">Access control for TMS delivery routing and SFA mobile field operations</field>
            <field name="sequence">25</field>
        </record>

        <!-- SFA Field User / Driver Group -->
        <record id="group_sfa_user" model="res.groups">
            <field name="name">SFA Field User / Driver</field>
            <field name="category_id" ref="module_category_operations_tms"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Field agents and delivery drivers. Can view outlet locations, submit field visit notes, and view assigned delivery routes. Unlinking is strictly prohibited.</field>
        </record>

        <!-- SFA & TMS Operations Manager Group -->
        <record id="group_sfa_manager" model="res.groups">
            <field name="name">SFA &amp; TMS Manager</field>
            <field name="category_id" ref="module_category_operations_tms"/>
            <field name="implied_ids" eval="[(4, ref('group_sfa_user')), (4, ref('stock.group_stock_user')), (4, ref('account.group_account_invoice'))]"/>
            <field name="comment">Logistics dispatchers and operations managers. Full control over delivery route scheduling, billing, and operational settings.</field>
        </record>
    </data>

    <data noupdate="1">
        <!-- Record Rule: SFA Field Driver sees only assigned pickings via driver_id with fallback to driver_name -->
        <record id="rule_stock_picking_sfa_user" model="ir.rule">
            <field name="name">SFA User: Assigned Delivery Pickings Only</field>
            <field name="model_id" ref="stock.model_stock_picking"/>
            <field name="groups" eval="[(4, ref('group_sfa_user'))]"/>
            <field name="domain_force">['|', ('driver_id', '=', user.id), '&amp;', ('driver_id', '=', False), ('driver_name', '=', user.name)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Record Rule: SFA Manager has global visibility on delivery pickings -->
        <record id="rule_stock_picking_sfa_manager" model="ir.rule">
            <field name="name">SFA Manager: Full Delivery Visibility</field>
            <field name="model_id" ref="stock.model_stock_picking"/>
            <field name="groups" eval="[(4, ref('group_sfa_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Record Rule: Multi-Company Res Partner for SFA User -->
        <record id="rule_res_partner_sfa_user" model="ir.rule">
            <field name="name">SFA User: Partner Multi-Company</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="groups" eval="[(4, ref('group_sfa_user'))]"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Dedicated System Integration User for Headless API Requests -->
        <record id="partner_sfa_api_service" model="res.partner">
            <field name="name">SFA API System Service</field>
            <field name="email">sfa_service@ibns.local</field>
        </record>

        <record id="user_sfa_api_service" model="res.users">
            <field name="name">SFA API System Service</field>
            <field name="login">sfa_api_service</field>
            <field name="email">sfa_service@ibns.local</field>
            <field name="partner_id" ref="partner_sfa_api_service"/>
            <field name="groups_id" eval="[(4, ref('group_sfa_manager'))]"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
