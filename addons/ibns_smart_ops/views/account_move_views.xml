<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Account Move Form Extension: SFA Idempotency Key in Other Info -->
    <record id="view_move_form_inherit_sfa" model="ir.ui.view">
        <field name="name">account.move.form.inherit.sfa</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='accounting_info_group']" position="inside">
                <field name="sfa_idempotency_key" readonly="1" invisible="not sfa_idempotency_key"/>
            </xpath>
        </field>
    </record>
</odoo>
