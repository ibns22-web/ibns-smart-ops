<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_sfa" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.sfa</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="80"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="IBNS Smart Ops" string="TMS &amp; SFA Ops" name="ibns_smart_ops" groups="ibns_smart_ops.group_sfa_manager">
                    <block title="Headless SFA API Security &amp; Credentials" id="sfa_api_security_settings">
                        <setting id="sfa_api_key_setting" help="Static integration bearer key for external systems (optional fallback to per-user API keys). Stored in system parameters (ir.config_parameter).">
                            <field name="sfa_api_key" password="True"/>
                        </setting>
                        <setting id="sfa_api_user_setting" help="Designated system user whose access rights are applied to integration API calls. Prevents superuser privilege escalation.">
                            <field name="sfa_api_user_id"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
